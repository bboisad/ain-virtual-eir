# Copy to ~/.streamlit/secrets.toml (outside the project folder) and fill in. Never commit or share a real key.
# Check the connection with:  python scripts/smoke_llm.py
LLM_PROVIDER = "openai"          # OpenAI API (also supports OpenAI-compatible endpoints)
LLM_API_KEY  = "..."
LLM_MODEL    = "gpt-5.6-luna"
LLM_BASE_URL = "https://api.openai.com/v1"
# LLM_TOOLS  = "auto"            # "auto" (native tool calling, JSON actions if the endpoint rejects tools) | "native" | "json"

# Cloud demonstration: run deploy/supabase.sql, then seed via scripts/migrate_cloud.py.
# Keep these server-side. Cloud mode requires a shared demo passcode.
# EIR_STORAGE = "supabase"
# SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# SUPABASE_SECRET_KEY = "sb_secret_REPLACE_ME"
# SUPABASE_BUCKET = "eir-files"
# EIR_DEMO_PASSWORD = "choose-a-long-shared-demo-passcode"
